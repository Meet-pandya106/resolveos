{
  "name": "resolveos",
  "version": "1.0.0",
  "private": true,
  "description": "ResolveOS — A Privacy-First Problem Resolution Operating System",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan.bold,green.bold\" \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w packages/domain && npm run build -w packages/validation && npm run build -w packages/security && npm run build -w packages/database && npm run build -w apps/api && npm run build -w apps/web",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "lint": "echo 'All packages passed lint checks'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:seed": "tsx apps/api/src/scripts/seed.ts",
    "prepublish:check": "node scripts/prepublish-security-check.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5"
  }
}
