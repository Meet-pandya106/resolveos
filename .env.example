# ResolveOS Environment Configuration
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration (Supports SQLite local file or Postgres)
DATABASE_URL=file:./resolveos.db
# DATABASE_URL=postgres://resolveos_user:resolveos_secret@localhost:5432/resolveos

# Authentication & Session Security (Never commit real keys)
JWT_SECRET=resolveos_super_secret_jwt_key_at_least_32_characters_long
SESSION_SECRET=resolveos_session_encryption_secret_key_minimum_32_chars
REFRESH_TOKEN_SECRET=resolveos_refresh_token_secret_key_minimum_32_chars

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:4000
SECURE_COOKIES=false

# Privacy & AI Processing (Defaults to OFF)
ENABLE_AI_SERVICE=false
AI_PROVIDER=disabled
AI_API_KEY=
AI_API_ENDPOINT=https://api.openai.com/v1

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Rate Limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_TIME_WINDOW_MS=60000
