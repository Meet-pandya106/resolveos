# ResolveOS Environment Configuration
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration
# REQUIRED FOR PERSISTENT PRODUCTION & SELF-HOSTED USE: PostgreSQL 14+
DATABASE_URL=postgres://resolveos_user:replace_with_strong_password@localhost:5432/resolveos
# DEVELOPMENT / DEMO ONLY (Ephemeral in-memory fallback):
# DATABASE_URL=:memory:

# Authentication & Session Security
# Generate secure 32+ character random secrets (e.g. `openssl rand -hex 32`):
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
SESSION_SECRET=replace_with_a_secure_random_session_secret_min_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_refresh_secret_min_32_chars

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:4000
SECURE_COOKIES=false

# Privacy & AI Processing (Defaults to OFF)
ENABLE_AI_SERVICE=false
AI_PROVIDER=disabled
AI_API_KEY=
AI_API_ENDPOINT=https://api.openai.com/v1

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Rate Limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_TIME_WINDOW_MS=60000
